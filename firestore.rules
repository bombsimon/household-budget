rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All household data is client-side encrypted with password
    // Security is provided by encryption, not Firebase rules
    match /households/{householdId} {
      // Household IDs act as a secret, so they must not be enumerable
      allow get, write: if true;
      allow list: if false;
    }
  }
}